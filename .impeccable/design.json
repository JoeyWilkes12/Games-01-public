  "narrative": {
    "northStar": "The Daylight Puzzle Exhibit",
    "overview": "Game Hub presents play and algorithmic investigation as things to handle and inspect. A cool daylight ground supports white working surfaces, dark blue-green text, geometric headings, and deliberate teal actions. The visible mechanisms—numbered tiles, colored puzzle pieces, dice, score bars, and source rows—provide the character.\n\nThe interface is calm around the activity and expressive within it. The hub uses a rotated tile board and small game illustrations; playable routes put their boards or dice ahead of assistance and settings; the lab and reading pages use precise controls, clear comparisons, and nearby source context. This records the implemented local preview, not a deployment or release claim.",
    "keyCharacteristics": [
      "Flat daylight surfaces with restrained borders.",
      "Geometric display type, readable prose, and distinct numeric typography.",
      "Puzzle and dice geometry as the visual signature.",
      "Phone layouts that keep play, controls, and evidence readable in sequence.",
      "Source context and limitations visible beside analysis."
    ],
    "rules": [
      {
        "name": "The Teal Action Rule",
        "body": "Teal identifies actions and selected analytical controls; clay and plum remain game, feedback, or focus colors.",
        "section": "colors"
      },
      {
        "name": "The Scope-Before-Color Rule",
        "body": "Comparisons carry board labels, values, and source context. A colored winner row or bar is accompanied by text, never the only explanation of the result.",
        "section": "colors"
      },
      {
        "name": "The Number-and-Explanation Rule",
        "body": "Use IBM Plex Mono for inspectable values and DM Sans for their explanation; use Space Grotesk for the playable tile or die itself.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep reading, comparison, settings, and analytics panels flat. Reserve lift for the puzzle exhibit, dice, and modal layers already present in the build.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** start from the daylight ground, white surfaces, ink text, and teal action roles recorded above.",
      "**Do** preserve compact, square play geometry and put assistance after the primary activity.",
      "**Do** keep numeric evidence aligned, labeled, and connected to its board and source.",
      "**Do** place source limits beside findings and retain citations and original recorded notes.",
      "**Do** keep responsive layouts readable by stacking, wrapping, and reducing padding before compressing the activity.",
      "**Do** preserve visible focus, accessible icon names, touch-sized controls, and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** turn clay or plum into competing global primary-action colors.",
      "**Don't** add elevated card treatment to every reading, settings, or analytics surface.",
      "**Don't** treat a local game theme or tile palette as the root website's palette.",
      "**Don't** use color alone to explain a selected result, chart value, or game outcome.",
      "**Don't** present imported observations as controlled benchmarks or invent missing time, move, win-rate, or maximum-tile metrics.",
      "**Don't** replace the self-hosted type hierarchy with a generic display face or use glyph characters as the reusable interface icon system."
    ]
  }
}
